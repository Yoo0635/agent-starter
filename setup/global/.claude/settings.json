{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/Users/user/.claude/hooks/kill-idle-terminal-shells.ps1",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/user/.claude/hooks/orca-card-status.js",
            "timeout": 20,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/user/.claude/hooks/orca-card-status.js",
            "timeout": 20,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(qa|be-worker)$",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/user/.claude/hooks/orca-card-status.js",
            "timeout": 20,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/user/.claude/hooks/orca-card-status.js",
            "timeout": 20,
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "C:/Users/user/.orca/agent-hooks/claude-statusline.cmd"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "firebase@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true,
    "harness@harness-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "harness-marketplace": {
      "source": {
        "source": "github",
        "repo": "revfactory/harness"
      },
      "autoUpdate": true
    }
  },
  "language": "korea",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public — this repo has no remotes configured, so visibility cannot be determined; treat as private local-only until a remote is added",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — no remotes configured and no commits tracked in this repo (0 tracked files, origin/HEAD unset)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (C:\\Users\\user\\Desktop\\AtMessenger) only — it has no configured remotes",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured — note: ~/.claude/CLAUDE.md lists internal SSH hosts (air, pro, mini, win, win209) over port 22022, but this is user-level (global CLAUDE.md), not org/repo evidence, so it is captured under User-specific below rather than treated as an org-wide trusted service",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: C:\\Users\\user\\Desktop\\AtMessenger (working directory; no remotes configured, no tracked files)",
      "**Org-specific CLIs**: None configured",
      "**Routine infra access under user's personal config**: per ~/.claude/CLAUDE.md, SSH to personal devices (air=<air IP>, pro=<pro IP>, mini=<mini IP>, win/db=<win IP>, win209=<win209 IP>) uses port 22022 via `~/.ssh/config` aliases (`ssh air|pro|mini|win|win209`, `scp ... air:~/`); this is personal-device access, not an org service"
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
